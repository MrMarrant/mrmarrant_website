<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}My Perfectly Normal Trip
			{% endblock %}
		</title>
		<link
		rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@48,400,0,0"/>
		{# Run `composer require symfony/webpack-encore-bundle` to start using Symfony UX #}
		{% block stylesheets %}
			{{ encore_entry_link_tags('app') }}
			{{ encore_entry_link_tags('mpnttaroi') }}
		{% endblock %}

		{% block javascripts %}
			{{ encore_entry_script_tags('app') }}
			{{ encore_entry_script_tags('mpnttaroi') }}
		{% endblock %}
	</head>
	<body>
    	{% block body %}
            <div class="border-page">
                <div class="border left"></div>
                <div class="content-page">
                    <section>
                        <div class="title-page"> 
                            <p style="font-size:200px;">MPNTTROI</p>
                            <p style="font-size:10px;">My Perfectly Normal Trip to a regular old Ikea</p>
                        </div>
                    </section>
					<hr>
                    <section class="navigation-page">
                        {% include '/mpnttaroi/header.html.twig' %}
                    </section>

					<section class="about-page">
						<img class="about-img" src={{asset('images/about_mpnttaroi.png')}}>
						<div class="position-absolute top-0 start-50 translate-middle">About MPNTTROI</div>
    					{# <a class="about-title">About MPNTTROI</a> #}
                    </section>
                </div>
                <div class="border right"></div>
            </div>
    	{% endblock %}
	</body>
</html>
